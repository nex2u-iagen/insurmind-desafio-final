# Chaves dos provedores LLM (BYOK) — opcionais: o modo offline não exige chave.
# Preencha apenas o provedor que usar (a sidebar do Streamlit grava aqui ao salvar).
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
# Alternativa para o provedor google: GEMINI_API_KEY=

# Modelo por provedor (a sidebar também grava <PROVEDOR>_MODEL ao definir)
OPENAI_MODEL=
GROQ_MODEL=
GOOGLE_MODEL=

# Opcionais do motor LLM
# SEGURAMENTE_LLM_TIMEOUT=60
# SEGURAMENTE_LLM_MODEL=gpt-5-mini  # compat: vale só para openai (depois de OPENAI_MODEL)
# SEGURAMENTE_ENV_FILE=/caminho/alternativo.env  # override do .env (testes/ambientes)
SEGURAMENTE_LOG_LEVEL=INFO

# Dados persistentes (o padrão local é <projeto>/data; Docker Compose usa volume próprio).
# SEGURAMENTE_DATA_DIR=/var/lib/seguramente

# Memória vetorial/grafo epochDB (instalada por requirements.txt).
# SEGURAMENTE_EMBEDDING=all-MiniLM-L6-v2  # embeddings locais; baixa o modelo no primeiro uso
# EPOCHDB_EXTRACTION_MODEL=local          # extração de triplas: local | google:gemini-2.5-flash
